{
  "name": "zombies",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:/\"",
    "dev:client": "pnpm --filter ./client dev",
    "dev:worker": "node -e \"require('fs').mkdirSync('client/dist',{recursive:true})\" && CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler dev --port 8787",
    "build": "pnpm --filter ./client build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate:local": "wrangler d1 migrations apply zombie-breakout-db --local",
    "assets": "node scripts/fetch-assets.mjs",
    "smoke": "node client/scripts/smoke-bot.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "wrangler": "^4.147.0"
  }
}
